# Copy to .env to configure docker compose. Every setting is optional for a
# local trial; `docker compose up` signs you in with DEV_LOGIN.

# The URL people and agents reach Jaz Tasks at. It is the only source for the
# OIDC redirect URI (PUBLIC_URL/auth/callback), the OAuth issuer and metadata
# URLs, issue links and the session cookie's domain.
PUBLIC_URL=http://localhost:7400

# Sign-in with any OpenID Connect provider. Signing keys come from the
# provider's discovery document, so nothing else is needed.
#
# Google: create an OAuth client (Web application) in Google Cloud Console >
# APIs & Services > Credentials and add PUBLIC_URL/auth/callback as an
# authorized redirect URI.
#   OIDC_ISSUER=https://accounts.google.com
# AWS Cognito: create an app client with a secret, allow the authorization
# code grant with the openid, email and profile scopes, and add
# PUBLIC_URL/auth/callback as a callback URL.
#   OIDC_ISSUER=https://cognito-idp.<region>.amazonaws.com/<userPoolId>
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Optional sign-in restriction, comma-separated. With both empty, anyone with
# a verified email may sign in; each new person gets a workspace of their
# own and joins others only by invite.
ALLOWED_EMAIL_DOMAINS=
ALLOWED_EMAILS=

# One-click sign-in as the owner of a seeded demo workspace for local
# development. Ignored when OIDC is configured, refused unless PUBLIC_URL is
# localhost; the demo workspace is only seeded in this mode.
DEV_LOGIN=1

# Optional fixed personal API key for the seeded owner (first start only).
# Leave empty to generate one; it is printed in the server log.
SEED_API_KEY=
